# Copy to .env.local for local dev, and add the same values in Vercel → Settings →
# Environment Variables. Contest details (name, date, venue, deadlines, links) live in
# contest.config.ts, not here. See docs/SETUP.md for where each value comes from.
#
# REQUIRED: Supabase, Stripe, NEXT_PUBLIC_BASE_URL, CRON_SECRET.
# Everything marked (optional) switches off cleanly when left blank.

# --- Supabase (required) ---
# Project Settings → API. Use a project just for this contest.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # server-only — never exposed to browser

# --- Stripe (required) — keep TEST keys until you've run a full test registration ---
#   STRIPE_WEBHOOK_SECRET comes from Dashboard → Developers → Webhooks after you
#   add the endpoint:  {NEXT_PUBLIC_BASE_URL}/api/webhooks/stripe  (events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, charge.refunded)
STRIPE_SECRET_KEY=sk_test_...                       # server-only — never exposed to browser
STRIPE_WEBHOOK_SECRET=whsec_...                     # server-only

# --- App (required) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Public contact address (overrides contest.config.ts)
NEXT_PUBLIC_CONTACT_EMAIL=
# Rules page link (overrides contest.config.ts)
NEXT_PUBLIC_RULES_URL=

# Scheduled jobs (email outbox drain, Stripe payment reconcile)
#   Vercel cron sends it automatically; Supabase pg_cron reads the same value
#   from Vault (contest_cron_secret — see docs/SETUP.md). At least 16 characters.
#   Generate with: openssl rand -base64 32
CRON_SECRET=

# Public results gate — leave false until the contest is over, then set
# to true so /results shows final standings to the public.
RESULTS_PUBLISHED=false

# Staff and admin access is Supabase Auth, not a shared password or PIN:
# /admin-dashboard, /judge and /dj sign in with a Supabase user whose row in
# contest_staff_accounts has an active role (admin | judge | dj | audio_tech).

# --- Deadline overrides (optional) ---
# Normally set in contest.config.ts → deadlines. ISO 8601 with the venue's UTC offset.
# Baked in at build time: redeploy after changing.
NEXT_PUBLIC_EARLY_BIRD_CUTOFF_ISO=
NEXT_PUBLIC_ONLINE_REG_CUTOFF_ISO=
NEXT_PUBLIC_MUSIC_DEADLINE_ISO=
NEXT_PUBLIC_COMP_CODE_EXPIRY_ISO=

# --- Email via Resend (optional) ---
# Without RESEND_API_KEY, emails queue in email_outbox, a line is logged for each, and nothing is sent
# until you set a key. Nothing is lost.
# Verify your sending domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO=
# Admin "Send test" for survey invites (default: contact email)
SURVEY_TEST_EMAIL=
# Where duplicate-payment alerts go (default: contact email)
ADMIN_ALERT_EMAIL=
# Email budget. Resend's free tier is 100/day per account; 90 leaves a buffer.
# Bulk email (survey invites, reminders) stops RESERVE below the limit so
# confirmations always get through.
EMAIL_DAILY_LIMIT=90
EMAIL_PRIORITY_RESERVE=30

# --- Rate limiting via Upstash/Vercel KV (optional; fails open when unset) ---
# Vercel dashboard → Storage → add an Upstash Redis store; it fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Deep health check (optional) ---
# GET /api/health?deep=1 runs a DB query only when the request sends this value
# as the x-healthcheck-token header (or ?token=). Plain /api/health always works.
HEALTHCHECK_TOKEN=

# Event-flag cache TTL in ms (default 30000). Lower it only for testing.
EVENT_FLAGS_CACHE_TTL_MS=30000

# --- Sentry error reporting (optional; off when unset) ---
# One DSN serves browser and server. Errors only: no tracing or replay.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for readable stack traces (source map upload):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- QStash backstop for the email drain (optional; off when unset) ---
# From console.upstash.com → QStash → Signing Keys. A QStash schedule calls
# the drain route; requests are accepted only with a valid signature.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Healthchecks.io job check-ins (optional; off when unset) ---
# Project ping key from healthchecks.io → Settings. Checks are created on
# their first ping; set each one's period and grace in the dashboard.
HEALTHCHECKS_PING_KEY=
